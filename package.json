{
  "name": "dsh-browser-harness",
  "version": "0.4.1",
  "description": "浏览器控制插件：把 browser-use / browser-harness 的 Browser Harness 注册为 DSH 会话工具，让 agent 直接写 Python 驱动真实 Chrome（导航/点击/输入/取无障碍树/截图），支持独立专用浏览器与附着系统浏览器两种模式；配置 TypeSafe key 后条件启用 browser_autopilot（Jev 目标式自动化）。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.py",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dshx": {
    "contributes": {
      "tools": [
        "browser_run",
        "browser_status",
        "browser_autopilot"
      ],
      "skills": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.1.0-rc.6 <0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaserchan/dsh-browser-harness.git"
  },
  "homepage": "https://github.com/chaserchan/dsh-browser-harness#readme",
  "bugs": {
    "url": "https://github.com/chaserchan/dsh-browser-harness/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "browser",
    "browser-use",
    "browser-harness",
    "automation",
    "cdp"
  ],
  "license": "MIT"
}
